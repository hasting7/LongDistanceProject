menu "Long Distance Tracker"

    config UPDATE_SYSTEM_SCREENS
        bool "Update system screens on boot"
        default n
        help
            on every boot download the system screens

    config SERVER_IP
        string "Server address"
        default "10.0.0.79"
        help
             name of server the ESP32 should connect to.

    choice SERVER_PROTOCOL
        prompt "Server protocol"
        default SERVER_PROTOCOL_HTTP

        config SERVER_PROTOCOL_HTTP
            bool "HTTP"

        config SERVER_PROTOCOL_HTTPS
            bool "HTTPS"
            
    endchoice

    config UPDATE_INTERVAL
        int "Update interval (seconds)"
        default 86400
        range 1 2147483647
        help
            How often the device updates its display.

    config WIFI_MAXIMUM_RETRY
        int "Max Wifi connection retries attempts"
        default 5
        range 1 20
        help
            How many retry attempts will be made before throwing an error.

endmenu